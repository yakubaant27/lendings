---
import Layout from '@lendings/ui/Layout.astro';
import Header from '@lendings/ui/Header.astro';
import Hero from '@lendings/ui/Hero.astro';
import ServicesPackages from '@lendings/ui/ServicesPackages.astro';
import Gallery from '@lendings/ui/Gallery.astro';
import Reviews from '@lendings/ui/Reviews.astro';
import Contacts from '@lendings/ui/Contacts.astro';
import BookingForm from '@lendings/ui/BookingForm.astro';
import { business, servicePackages, reviews } from '../data/site';
import heroImage from '../assets/hero/bmw-tint.jpg';
import logoWhite from '../assets/brand/logo-white.png';
import tintDetail from '../assets/gallery/tint-detail.jpg';
import detailingSuv from '../assets/gallery/detailing-suv.jpg';
import detailingPriora from '../assets/gallery/detailing-priora.jpg';
import fordFocusShop from '../assets/gallery/ford-focus-shop.jpg';

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address,
    addressLocality: 'Каменск-Уральский',
    addressCountry: 'RU',
  },
  url: canonicalUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: business.rating,
    reviewCount: business.reviewsCount,
  },
};

const galleryImages = [
  { src: detailingSuv, alt: 'Детейлинг и полировка кузова — студия Ku_ton_66' },
  { src: tintDetail, alt: 'Крупный план тонировочной плёнки на заднем стекле' },
  { src: detailingPriora, alt: 'Результат комплексного детейлинга — глянцевый чёрный кузов' },
  { src: fordFocusShop, alt: 'Автомобиль в боксе студии Ku_ton_66 на подъёмнике' },
];
---

<Layout
	title={`${business.name} — детейлинг-студия в Каменске-Уральском`}
	description={business.tagline}
	canonicalUrl={canonicalUrl}
	schema={schema}
>
	<Header logo={logoWhite} businessName={business.name} ctaText="Записаться" ctaHref="#booking" />
	<Hero
		businessName={business.name}
		tagline={business.tagline}
		ctaText="Записаться"
		ctaHref="#booking"
		rating={business.rating}
		reviewsCount={business.reviewsCount}
		address={business.address}
		backgroundImage={heroImage}
	/>
	<ServicesPackages heading="Услуги" packages={servicePackages} />
	<Gallery heading="Наши работы" subheading="Реальные автомобили из нашей студии" images={galleryImages} />
	<Reviews heading="Отзывы" rating={business.rating} reviewsCount={business.reviewsCount} reviews={reviews} />
	<Contacts
		heading="Контакты"
		address={business.address}
		hours={business.hours}
		vk={business.vk}
		instagram={business.instagram}
		mapQuery={business.address}
	/>
	<BookingForm
		heading="Записаться"
		subheading="Оставьте заявку — перезвоним и согласуем удобное время"
		workerUrl="https://lendings.yakuba-ant27.workers.dev"
	/>

	<p class="px-6 py-10 text-center text-xs text-neutral-600 sm:px-10">
		Демонстрационный проект. Не является официальным сайтом компании.
	</p>
</Layout>
