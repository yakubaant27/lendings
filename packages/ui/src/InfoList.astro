---
interface Props {
  heading: string;
  items: string[];
}

const { heading, items } = Astro.props;
---

<section class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-2xl">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
		<ul class="mt-8 flex flex-col gap-4">
			{items.map((item, index) => (
				<li class="flex gap-4 rounded-xl border border-white/10 bg-white/5 p-5">
					<span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-cyan-400 font-semibold text-neutral-950">
						{index + 1}
					</span>
					<span class="text-neutral-200">{item}</span>
				</li>
			))}
		</ul>
	</div>
</section>
