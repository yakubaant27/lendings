---
interface Props {
  heading: string;
  address: string;
  hours: string;
  vk?: string;
  instagram?: string;
  mapQuery: string;
}

const { heading, address, hours, vk, instagram, mapQuery } = Astro.props;
const mapSrc = `https://yandex.ru/map-widget/v1/?text=${encodeURIComponent(mapQuery)}&z=17`;
---

<section id="contacts" class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-6xl">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>

		<div class="mt-10 grid gap-8 lg:grid-cols-2">
			<div class="flex flex-col gap-6 rounded-2xl border border-white/10 bg-white/5 p-6">
				<div>
					<p class="text-sm text-neutral-500">Адрес</p>
					<p class="mt-1 text-lg text-white">{address}</p>
				</div>
				<div>
					<p class="text-sm text-neutral-500">Часы работы</p>
					<p class="mt-1 text-lg text-white">{hours}</p>
				</div>
				{(vk || instagram) && (
					<div>
						<p class="text-sm text-neutral-500">Мы в соцсетях</p>
						<div class="mt-2 flex gap-4">
							{vk && (
								<a href={vk} target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300">
									VK
								</a>
							)}
							{instagram && (
								<a href={instagram} target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300">
									Instagram
								</a>
							)}
						</div>
					</div>
				)}
			</div>

			<div class="overflow-hidden rounded-2xl border border-white/10">
				<iframe
					src={mapSrc}
					width="100%"
					height="100%"
					loading="lazy"
					class="min-h-[320px] w-full"
					title={`Карта: ${address}`}
				></iframe>
			</div>
		</div>
	</div>
</section>
