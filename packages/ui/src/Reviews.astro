---
interface Review {
  name: string;
  text: string;
}

interface Props {
  heading: string;
  rating: number;
  reviewsCount: number;
  reviews: Review[];
  sourceLabel?: string;
}

const { heading, rating, reviewsCount, reviews, sourceLabel = 'Яндекс.Карты' } = Astro.props;
---

<section id="reviews" class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
			<p class="text-sm text-neutral-400">
				<span class="text-amber-400">★ {rating.toFixed(1)}</span>
				<span> · {reviewsCount} отзывов на {sourceLabel}</span>
			</p>
		</div>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{reviews.map((review) => (
				<figure class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/5 p-6">
					<blockquote class="flex-1 text-neutral-300">
						«{review.text}»
					</blockquote>
					<figcaption class="text-sm font-medium text-white">{review.name}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
