---
interface CatalogItem {
  name: string;
  price: number;
  unit: string;
}

interface CatalogCategory {
  category: string;
  items: CatalogItem[];
}

interface Props {
  heading: string;
  catalog: CatalogCategory[];
}

const { heading, catalog } = Astro.props;
const priceFormatter = new Intl.NumberFormat('ru-RU');
---

<section id="catalog" class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-6xl">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>

		<div class="mt-10 flex flex-col gap-12">
			{catalog.map((group) => (
				<div>
					<h3 class="mb-4 text-xl font-semibold text-white">{group.category}</h3>
					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{group.items.map((item) => (
							<div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-5 py-4">
								<span class="text-neutral-200">{item.name}</span>
								<span class="font-semibold text-cyan-400">
									{priceFormatter.format(item.price)} ₽/{item.unit}
								</span>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
