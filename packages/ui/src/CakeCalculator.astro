---
interface Cake {
  name: string;
  pricePerKg: number;
}

interface Props {
  heading: string;
  subheading?: string;
  cakes: Cake[];
}

const { heading, subheading, cakes } = Astro.props;
const calcId = 'cake-calculator';
---

<section id="calculator" class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-xl">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
		{subheading && <p class="mt-2 text-neutral-400">{subheading}</p>}

		<div id={calcId} class="mt-8 flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/5 p-6">
			<div>
				<label for="cake-type" class="mb-1 block text-sm text-neutral-400">Тип торта</label>
				<select
					id="cake-type"
					class="w-full rounded-lg border border-white/10 bg-neutral-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none"
				>
					{cakes.map((cake) => (
						<option value={cake.pricePerKg}>{cake.name} — {cake.pricePerKg} ₽/кг</option>
					))}
				</select>
			</div>

			<div>
				<label for="cake-weight" class="mb-1 block text-sm text-neutral-400">Вес, кг</label>
				<input
					id="cake-weight"
					type="number"
					min="0.5"
					step="0.5"
					value="1.5"
					class="w-full rounded-lg border border-white/10 bg-neutral-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none"
				/>
			</div>

			<div class="mt-2 rounded-lg bg-cyan-400/10 px-4 py-3 text-center">
				<span class="text-sm text-neutral-400">Примерная стоимость: </span>
				<span data-result class="text-xl font-bold text-cyan-400">0 ₽</span>
			</div>
			<p class="text-xs text-neutral-500">Точная цена зависит от оформления, уточняется при заказе.</p>
		</div>
	</div>
</section>

<script define:vars={{ calcId }}>
	const root = document.getElementById(calcId);
	const typeSelect = root.querySelector('#cake-type');
	const weightInput = root.querySelector('#cake-weight');
	const result = root.querySelector('[data-result]');
	const formatter = new Intl.NumberFormat('ru-RU');

	function recalc() {
		const pricePerKg = Number(typeSelect.value) || 0;
		const weight = Number(weightInput.value) || 0;
		result.textContent = `${formatter.format(Math.round(pricePerKg * weight))} ₽`;
	}

	typeSelect.addEventListener('change', recalc);
	weightInput.addEventListener('input', recalc);
	recalc();
</script>
