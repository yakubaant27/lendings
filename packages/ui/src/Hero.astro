---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  businessName: string;
  tagline: string;
  ctaText: string;
  ctaHref: string;
  rating: number;
  reviewsCount: number;
  address: string;
  backgroundImage?: ImageMetadata;
}

const { businessName, tagline, ctaText, ctaHref, rating, reviewsCount, address, backgroundImage } = Astro.props;
const isExternal = ctaHref.startsWith('http');
---

<section class="relative flex min-h-[90svh] flex-col justify-center overflow-hidden px-6 py-20 sm:px-10">
	{backgroundImage ? (
		<>
			<Image
				src={backgroundImage}
				alt=""
				loading="eager"
				widths={[640, 1280, 1920]}
				sizes="100vw"
				class="absolute inset-0 -z-20 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 -z-10 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-transparent"></div>
			<div class="absolute inset-0 -z-10 bg-gradient-to-r from-neutral-950/80 via-neutral-950/20 to-transparent"></div>
		</>
	) : (
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,rgba(56,189,248,0.15),transparent_60%)]"></div>
	)}

	<div class="mx-auto flex w-full max-w-3xl flex-col items-start gap-6">
		<span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-neutral-300 backdrop-blur">
			<span class="text-amber-400">★ {rating.toFixed(1)}</span>
			<span class="text-neutral-500">·</span>
			<span>{reviewsCount} отзывов на Яндекс.Картах</span>
		</span>

		<h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
			{businessName}
		</h1>

		<p class="max-w-xl text-lg text-neutral-200 sm:text-xl">
			{tagline}
		</p>

		<a
			href={ctaHref}
			target={isExternal ? '_blank' : undefined}
			rel={isExternal ? 'noopener noreferrer' : undefined}
			class="inline-flex items-center justify-center rounded-full bg-cyan-400 px-8 py-4 text-base font-semibold text-neutral-950 transition hover:bg-cyan-300 active:scale-[0.98]"
		>
			{ctaText}
		</a>

		<p class="text-sm text-neutral-300">{address}</p>
	</div>
</section>
