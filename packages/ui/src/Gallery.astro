---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  heading: string;
  subheading?: string;
  images: GalleryItem[];
}

const { heading, subheading, images } = Astro.props;
---

<section id="gallery" class="px-6 py-20 sm:px-10">
	<div class="mx-auto max-w-6xl">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
		{subheading && <p class="mt-2 max-w-xl text-neutral-400">{subheading}</p>}

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{images.map((item) => (
				<div class="overflow-hidden rounded-2xl border border-white/10">
					<Image
						src={item.src}
						alt={item.alt}
						loading="lazy"
						widths={[400, 800, 1200]}
						sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
						class="h-full w-full object-cover"
					/>
				</div>
			))}
		</div>
	</div>
</section>
